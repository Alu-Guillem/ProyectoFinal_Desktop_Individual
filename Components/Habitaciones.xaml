<UserControl x:Class="PereMaria.GestorHotel.Components.Habitaciones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PereMaria.GestorHotel.Components"
             xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
             mc:Ignorable="d" 
             d:DesignHeight="400"
               Height="400" Width="320"
             >
    <Border BorderBrush="{StaticResource Bg-Purple-Accent}" BorderThickness="2" Margin="10" CornerRadius="8" ClipToBounds="True" Background="{StaticResource Bg-Cosmic-Mid}" Cursor="Hand">
        <Grid MouseDown="Grid_Click">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <!-- Style -->
                <Style TargetType="Label">
                    <Setter Property="Foreground" Value="{StaticResource Bg-Light}"/>
                    <Setter Property="FontSize" Value="30px"/>
                </Style>
            </Grid.Resources>

            <Grid Grid.Row="0" Margin="10">
                <!-- Cabecera -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Image Width="100" Height="100" Grid.Column="0" >
                    <Image.Source>
                        <PriorityBinding>
                            <Binding Path="GridImageUrl" UpdateSourceTrigger="PropertyChanged"/>
                            <Binding Source="pack://application:,,,/Resources/logo.png"/>
                        </PriorityBinding>
                    </Image.Source>
                </Image>
                <StackPanel Orientation="Vertical" Grid.Column="1" HorizontalAlignment="Center">
                    <Label FontWeight="Bold" Content="{Binding Name}"/>
                    <!-- Nombre -->
                    <Label Content="{Binding Type}"/>
                    <!-- Tipo -->

                    <Label FontWeight="Bold">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Setter Property="Content" Value="✓ Libre"/>
                                <Setter Property="Foreground" Value="{StaticResource Bg-Success}"/>
                                <Setter Property="FontSize" Value="30px"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Closed}" Value="True">
                                        <Setter Property="Content" Value="Cerrada"/>
                                        <Setter Property="Foreground" Value="{StaticResource Bg-Danger}"/>
                                    </DataTrigger>

                                    <!-- If Occuped == true -->
                                    <DataTrigger Binding="{Binding Occuped}" Value="True">
                                        <Setter Property="Content" Value="✗ Ocupado"/>
                                        <Setter Property="Foreground" Value="{StaticResource Bg-Danger}"/>
                                    </DataTrigger>
                                    <!-- Occuped == false and Maintenance == true -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Occuped}" Value="False"/>
                                            <Condition Binding="{Binding Maintenance}" Value="True"/>
                                            <Condition Binding="{Binding Closed}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Content" Value="🛠 Manten."/>
                                        <Setter Property="Foreground" Value="{StaticResource Bg-Warning}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Label.Style>
                    </Label>
                    
                    <!-- Estado -->
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Vertical" Margin="10" Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                    <Label Content="nº" FontWeight="Bold"/>
                    <Label Content="{Binding Number}"/>
                </StackPanel>
                <!-- nº de habitaciones -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="☻" FontWeight="Bold"/>
                    <Label Content="{Binding OccupancyLimit}"/>
                    <Label Content="Personas"/>
                </StackPanel>
                <!-- Capacidad -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding PricePerNight}"/>
                    <Label FontWeight="Bold" Height="auto" Content="€"/>
                </StackPanel>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
