<UserControl x:Class="PereMaria.GestorHotel.Components.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controller="clr-namespace:PereMaria.GestorHotel.Controllers"
             mc:Ignorable="d"
             d:DesignHeight="Infinity" MinHeight="500" MinWidth="250" MaxWidth="300">
    <Border Background="{StaticResource Bg-Secondary}" Padding="20 15">
        <StackPanel Orientation="Vertical"
                    TextElement.Foreground="{StaticResource Bg-White}">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/logo.png" Width="100"></Image>
                <StackPanel VerticalAlignment="Center" Margin="0 25">
                    <TextBlock FontSize="16" FontWeight="Bold">Hotel Pere Maria</TextBlock>
                    <TextBlock FontSize="10">Dashboard</TextBlock>
                </StackPanel>
            </StackPanel>
            <Border Height="1" Background="#E6EDF3"></Border>
            <ListView
                ItemsSource="{x:Static controller:NavigationController.ROUTES}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Button Command="{Binding Value}">
                                <TextBlock Text="{Binding Key }" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </StackPanel>
    </Border>
</UserControl>