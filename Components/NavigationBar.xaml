<UserControl x:Class="PereMaria.GestorHotel.Components.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controller="clr-namespace:PereMaria.GestorHotel.Controllers"
             mc:Ignorable="d"
             d:DesignHeight="Infinity" MinHeight="500" MinWidth="250" MaxWidth="300">

    <Border Background="{StaticResource Bg-Secondary}" Padding="20 15">
        <StackPanel Orientation="Vertical"
                    TextElement.Foreground="{StaticResource Bg-White}">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/logo.png" Width="100"></Image>
                <StackPanel VerticalAlignment="Center" Margin="0 25">
                    <TextBlock FontSize="16" FontWeight="Bold">Hotel Pere Maria</TextBlock>
                    <TextBlock FontSize="10">Dashboard</TextBlock>
                </StackPanel>
            </StackPanel>
            <Border Height="1" Background="#E6EDF3"></Border>
            <!-- Navigation Menu -->
            <ListBox
                ItemsSource="{Binding Source={x:Static controller:NavigationController.Instance}, Path=ROUTES}"
                SelectedValue="{Binding Source={x:Static controller:NavigationController.Instance}, Path=CurrentView, Mode=TwoWay}"
                SelectedValuePath="Key"
                BorderThickness="0"
                Background="Transparent"
                Margin="0,15,0,0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                Focusable="False"
                SelectionMode="Single"
                KeyboardNavigation.TabNavigation="None"
                ItemContainerStyle="{StaticResource NavListBoxItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Value}" Style="{StaticResource NavButtonStyle}">
                            <TextBlock Text="{Binding Key}" />
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>
    </Border>
</UserControl>