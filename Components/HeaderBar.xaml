<UserControl x:Class="PereMaria.GestorHotel.Components.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:PereMaria.GestorHotel.Components"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="800" MinWidth="500" Height="100">
    <Grid Background="{StaticResource Bg-Cosmic-Dark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
        </Grid.RowDefinitions>
        <Border Padding="30 20">
            <DockPanel VerticalAlignment="Stretch" LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <components:AvatarInitial Initial="M" Size="40" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource Text-Primary}" FontSize="12"
                                   FontWeight="Bold">
                            Mateo Manchola
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="10"
                                   FontWeight="Medium">
                            Administrador
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Height="1" Background="{StaticResource Nav-Border}"/>
    </Grid>
</UserControl>