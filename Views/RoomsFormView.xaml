<UserControl x:Class="PereMaria.GestorHotel.Views.RoomsFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
    xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
    mc:Ignorable="d"
    d:DesignHeight="930" d:DesignWidth="1650"
    DataContext="{x:Static controllers:RoomsViewModel.Instance}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <!-- Style -->
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource Bg-Light}"/>
                <Setter Property="FontSize" Value="20px"/>
            </Style>
        </Grid.Resources>

        <!-- Content -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="10" Grid.RowSpan="2">
            
            <StackPanel Margin="0 10 0 10">
                <Label Content="Nombre"/>
                <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.Name}"/>
            </StackPanel>
            
            <StackPanel Margin="0 10 0 10">
                <Label Content="Tipo"/>
                <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.Type}"/>
            </StackPanel>

            <!-- Precio y Oferta -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0 10 15 10" Grid.Column="0">
                    <Label Content="Precio"/>
                    <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.PricePerNight}"/>
                </StackPanel>
                <StackPanel Margin="15 10 0 10" Grid.Column="1">
                    <Label Content="Offerta"/>
                    <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.Offer}"/>
                </StackPanel>
            </Grid>

            
            <StackPanel Margin="0 10 0 10">
                <Label Content="Ocupacion Maxima"/>
                <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.OccupancyLimit}"/>
            </StackPanel>

            <StackPanel Margin="0 10 0 10">
                <Label Content="Numero"/>
                <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.Number}"/>
            </StackPanel>
            <StackPanel Margin="0 10 0 10">
                <Label Content="Descripcion"/>
                <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="160" Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.Description}" />
            </StackPanel>

        </StackPanel>
        
        <!-- Image -->
        <DockPanel Grid.Column="1" Grid.Row="0" Margin="5"> 
            <Label Content="Imagen: " DockPanel.Dock="Top"/>
            <Border BorderBrush="{StaticResource Bg-Purple-Accent}" BorderThickness="1" VerticalAlignment="Center">
                <Image Source="/Resources/logo.png"/>
            </Border>
        </DockPanel>

        
        <!-- Buttons -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Eliminar" Command="{Binding DeleteCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10 10 30 10" Height="50" FontSize="20" />
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10" Height="50" FontSize="20" />
            <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="10" Height="50" FontSize="20" />
        </StackPanel>

    </Grid>
</UserControl>