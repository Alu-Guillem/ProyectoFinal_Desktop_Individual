<UserControl x:Class="PereMaria.GestorHotel.Views.RoomsFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
    xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
    mc:Ignorable="d"
    d:DesignHeight="930" d:DesignWidth="1650"
    DataContext="{x:Static controllers:RoomsViewModel.Instance}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <!-- Style -->
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource Bg-Light}"/>
                <Setter Property="FontSize" Value="20px"/>
            </Style>
        </Grid.Resources>

        <!-- Content -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="10" Grid.RowSpan="2">
            
            <StackPanel Margin="0 10 0 10">
                <Label Content="Nombre"/>
                <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.Name}" PreviewTextInput="String_PreviewTextInput"/>
            </StackPanel>
            
            <StackPanel Margin="0 10 0 10">
                <Label Content="Tipo"/>
                <ComboBox Style="{StaticResource DropdownStyle}" Width="auto" Margin="0 10 0 0" ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding CurrentRoom.Type, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Precio y Oferta -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0 10 15 10" Grid.Column="0">
                    <Label Content="Precio"/>
                    <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.PricePerNight}" PreviewTextInput="Price_PreviewTextInput"/>
                </StackPanel>
                <StackPanel Margin="15 10 0 10" Grid.Column="1">
                    <Label Content="Offerta"/>
                    <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.Offer}" PreviewTextInput="Int_PreviewTextInput" MaxLength="3"/>
                </StackPanel>
            </Grid>

            
            <StackPanel Margin="0 10 0 10">
                <Label Content="Ocupacion Maxima"/>
                <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.OccupancyLimit}" PreviewTextInput="Int_PreviewTextInput"/>
            </StackPanel>

            <StackPanel Margin="0 10 0 10">
                <Label Content="Numero"/>
                <TextBox Width="auto" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.Number}" PreviewTextInput="Int_PreviewTextInput"/>
            </StackPanel>
            <StackPanel Margin="0 10 0 10">
                <Label Content="Descripcion"/>
                <TextBox AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource TextBoxStyle}" Text="{Binding CurrentRoom.Description}" />
            </StackPanel>

        </StackPanel>
        
        <!-- Image -->
        <DockPanel Grid.Column="1" Grid.Row="0" Margin="5"> 
            <Label Content="Imagen: " DockPanel.Dock="Top"/>
            <Button DockPanel.Dock="Bottom" Content="Seleccionar Imagen" Click="SelectImage_Click" Style="{StaticResource ActionButtonStyle}" Margin="5 10 5 5"/>
            <Border BorderBrush="{StaticResource Bg-Purple-Accent}" BorderThickness="1">
                <Image x:Name="ImgPreview" Stretch="Uniform" Source="{Binding FullImageUrl, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>
        </DockPanel>

        <!-- Estado -->
        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Orientation="Horizontal" >
            <Button Content="Cerrar" Command="{Binding CloseCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0 10 10 10" Height="40" FontSize="14"/>
            <Button Content="Mantenimiento" Click="Maintenance_Button" Style="{StaticResource ActionButtonStyle}" Margin="10 10 10 10" Height="40" FontSize="14"/>
        </StackPanel> 

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Eliminar" Command="{Binding DeleteCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10 10 30 10" Height="50" FontSize="20" />
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10" Height="50" FontSize="20" />
            <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="10" Height="50" FontSize="20" />
        </StackPanel>

    </Grid>
</UserControl>