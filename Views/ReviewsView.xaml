<!-- Vista de análisis de reseñas: filtros, métricas y tabla de resultados -->
<UserControl x:Class="PereMaria.GestorHotel.Views.ReviewsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
    xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
    mc:Ignorable="d"
    d:DesignHeight="300" d:DesignWidth="300"
    DataContext="{x:Static controllers:ReviewsViewModel.Instance}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Reseñas de Huéspedes"
            FontSize="20"
            FontWeight="Bold"
            Foreground="{StaticResource Text-Primary}"
            Margin="0 10" />

        <Border Grid.Row="1"
            Background="{StaticResource Bg-Cosmic-Mid}"
            BorderBrush="{StaticResource Bg-Purple-Accent}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Margin="0 0 0 12">
            <StackPanel>
                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                        Margin="0 0 12 0">
                        <TextBlock Text="Habitación"
                            Style="{StaticResource TableSubText}" />
                        <ComboBox ItemsSource="{Binding RoomFilterOptions}"
                            SelectedItem="{Binding SelectedRoomFilter}"
                            DisplayMemberPath="Label"
                            Margin="0 4 0 0"
                            Background="{StaticResource Bg-Input}"
                            Foreground="{StaticResource Text-Primary}"
                            BorderBrush="{StaticResource Bg-Purple-Accent}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Cliente"
                            Style="{StaticResource TableSubText}" />
                        <ComboBox ItemsSource="{Binding CustomerFilterOptions}"
                            SelectedItem="{Binding SelectedCustomerFilter}"
                            DisplayMemberPath="Label"
                            Margin="0 4 0 0"
                            Background="{StaticResource Bg-Input}"
                            Foreground="{StaticResource Text-Primary}"
                            BorderBrush="{StaticResource Bg-Purple-Accent}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                        Margin="0 0 12 0">
                        <TextBlock Text="Buscar"
                            Style="{StaticResource TableSubText}" />
                        <TextBox
                            Text="{Binding FilterSearchText, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0 4 0 0"
                            Background="{StaticResource Bg-Input}"
                            Foreground="{StaticResource Text-Primary}"
                            BorderBrush="{StaticResource Bg-Purple-Accent}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                        Margin="0 0 12 0">
                        <TextBlock Text="Calif. mínima"
                            Style="{StaticResource TableSubText}" />
                        <TextBox
                            Text="{Binding FilterMinRateText, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0 4 0 0"
                            Background="{StaticResource Bg-Input}"
                            Foreground="{StaticResource Text-Primary}"
                            BorderBrush="{StaticResource Bg-Purple-Accent}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                        Margin="0 0 12 0">
                        <TextBlock Text="Calif. máxima"
                            Style="{StaticResource TableSubText}" />
                        <TextBox
                            Text="{Binding FilterMaxRateText, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0 4 0 0"
                            Background="{StaticResource Bg-Input}"
                            Foreground="{StaticResource Text-Primary}"
                            BorderBrush="{StaticResource Bg-Purple-Accent}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                        Margin="0 0 12 0">
                        <TextBlock Text="Desde"
                            Style="{StaticResource TableSubText}" />
                        <TextBox
                            Text="{Binding FilterFromDateText, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0 4 0 0"
                            Background="{StaticResource Bg-Input}"
                            Foreground="{StaticResource Text-Primary}"
                            BorderBrush="{StaticResource Bg-Purple-Accent}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Hasta"
                            Style="{StaticResource TableSubText}" />
                        <TextBox
                            Text="{Binding FilterToDateText, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0 4 0 0"
                            Background="{StaticResource Bg-Input}"
                            Foreground="{StaticResource Text-Primary}"
                            BorderBrush="{StaticResource Bg-Purple-Accent}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                        Content="Aplicar"
                        Command="{Binding ApplyFiltersCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0 0 8 0"
                        Padding="16 6" />

                    <Button Grid.Column="1"
                        Content="Limpiar"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0 0 8 0"
                        Padding="16 6" />

                    <Button Grid.Column="2"
                        Content="Actualizar"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0 0 8 0"
                        Padding="16 6" />

                    <TextBlock Grid.Column="3"
                        Text="{Binding FilterError}"
                        Foreground="{StaticResource Bg-Warning}"
                        FontWeight="SemiBold"
                        Visibility="{Binding HasFilterError, Converter={StaticResource BoolToVisibility}}"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
            Background="{StaticResource Bg-Cosmic-Mid}"
            BorderBrush="{StaticResource Bg-Purple-Accent}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Margin="0 6 0 12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding AverageRating, StringFormat=0.0}"
                        FontSize="40"
                        FontWeight="Bold"
                        Foreground="{StaticResource Text-Primary}" />
                    <StackPanel Orientation="Horizontal"
                        Margin="0 6 0 0">
                        <TextBlock FontFamily="{StaticResource Material-Icons}"
                            Text="star"
                            FontSize="16"
                            Foreground="{StaticResource Bg-Warning}"
                            Margin="0 0 6 0" />
                        <TextBlock Text="Promedio"
                            Foreground="{StaticResource Text-Secondary}"
                            FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalReviewsLabel}"
                        Foreground="{StaticResource Text-Secondary}"
                        FontSize="12"
                        Margin="0 6 0 0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                    Margin="10 0">
                    <TextBlock Text="Distribución por estrellas"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text-Primary}"
                        Margin="0 0 0 8" />
                    <ItemsControl ItemsSource="{Binding RatingBreakdown}"
                        Visibility="{Binding HasReviews, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Stars}"
                                        Foreground="{StaticResource Text-Secondary}"
                                        VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1"
                                        Height="8"
                                        Maximum="100"
                                        Value="{Binding Percentage}"
                                        Background="#2D2055"
                                        Foreground="{StaticResource Bg-Success}"
                                        Margin="8 0" />
                                    <TextBlock Grid.Column="2"
                                        Text="{Binding Count}"
                                        Foreground="{StaticResource Text-Secondary}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Sin reseñas"
                        Foreground="{StaticResource Text-Secondary}"
                        Visibility="{Binding NoReviews, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Top habitaciones"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text-Primary}"
                        Margin="0 0 0 8" />
                    <ItemsControl ItemsSource="{Binding TopRooms}"
                        Visibility="{Binding HasReviews, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1F1638"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0 0 0 8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RoomName}"
                                            Foreground="{StaticResource Text-Primary}"
                                            FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AverageRating, StringFormat=0.0}"
                                            Foreground="{StaticResource Text-Secondary}"
                                            FontSize="12" />
                                        <TextBlock
                                            Text="{Binding ReviewsCount, StringFormat={}{0} reseñas}"
                                            Foreground="{StaticResource Text-Secondary}"
                                            FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Sin reseñas"
                        Foreground="{StaticResource Text-Secondary}"
                        Visibility="{Binding NoReviews, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
            Style="{StaticResource TableContainerStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                    Style="{StaticResource TableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cliente"
                            Grid.Column="0"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Habitación"
                            Grid.Column="1"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Puntuación"
                            Grid.Column="2"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Comentario"
                            Grid.Column="3"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Fecha"
                            Grid.Column="4"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Reviews}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="1.3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding GuestName}"
                                            Grid.Column="0"
                                            Style="{StaticResource TableMainText}"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RoomName}"
                                            Grid.Column="1"
                                            Style="{StaticResource TableMutedText}"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Rate, StringFormat={}{0:0.0}/5}"
                                            Grid.Column="2"
                                            Style="{StaticResource TableMutedText}"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Comment}"
                                            Grid.Column="3"
                                            Style="{StaticResource TableMutedText}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CreatedAt}"
                                            Grid.Column="4"
                                            Style="{StaticResource TableMutedText}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding NoReviews, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Aun no hay reseñas para mostrar"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text-Secondary}" />
                </Border>
                <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontWeight="UltraBold">Cargando...</TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>