<UserControl x:Class="PereMaria.GestorHotel.Views.RoomsHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
             xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             DataContext="{x:Static controllers:RoomsViewModel.Instance}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sección Superior: Resumen -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Estadísticas de Habitaciones" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Bg-Light}"/>

            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Border Background="{StaticResource Bg-Purple-Accent}" CornerRadius="8" Padding="15,10" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Total Habitaciones" Style="{StaticResource TableSubText}" Foreground="{StaticResource Bg-Light}"/>
                        <TextBlock Text="{Binding TotalRooms}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Bg-Light}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Bg-Success}" CornerRadius="8" Padding="15,10">
                    <StackPanel>
                        <TextBlock Text="Ocupación Actual" Style="{StaticResource TableSubText}" Foreground="{StaticResource Bg-Light}"/>
                        <TextBlock Text="{Binding OccupedRooms}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Bg-Light}"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Border Background="{StaticResource Bg-Cosmic-Mid}" CornerRadius="8" Padding="15,10" Margin="15,0,0,0" BorderBrush="{StaticResource Bg-Success}" BorderThickness="0,0,0,3">
                        <StackPanel>
                            <TextBlock Text="Ganancias Totales" Style="{StaticResource TableSubText}" Foreground="{StaticResource Bg-Light}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalRevenueDisplay, StringFormat={}{0:N2}€}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Bg-Success}"/>

                                <TextBlock Text="{Binding RevenueComparison}" 
                           FontSize="14" 
                           Margin="10,0,0,0" 
                           VerticalAlignment="Bottom" 
                           Foreground="{StaticResource Bg-Success}" 
                           Visibility="{Binding RevenueComparison}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>


            <StackPanel Orientation="Horizontal" Margin="10,20,0,10">
                <TextBlock Text="Ordenar por:" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource TableSubText}"/>
                <Button Content="Más Rentables" Command="{Binding SortByRevenueCommand}" Style="{StaticResource ActionButtonStyle}"  Margin="5,0,5,0" Padding="15,5"/>
                <Button Content="Más Reservadas" Command="{Binding SortByBookingsCommand}" Style="{StaticResource ActionButtonStyle}" Padding="15,5"/>

                <TextBlock Text="Filtrar por año:" VerticalAlignment="Center" Style="{StaticResource TableSubText}" Margin="10,0,10,0"/>

                <ComboBox Width="120" ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}" Style="{StaticResource DropdownStyle}" Padding="10"/>


                <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource ActionButtonStyle}" Background="{StaticResource Bg-Purple-Accent}" Padding="7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="file_download" FontFamily="{StaticResource Material-Icons}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Exportar CSV" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>

        <!-- Tabla de Datos -->
        <Border Grid.Row="1" Style="{StaticResource TableContainerStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabecera de la Tabla -->
                <Border Grid.Row="0" Style="{StaticResource TableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Habitacion -->
                            <ColumnDefinition Width="2*" />
                            <!-- Tipo -->
                            <ColumnDefinition Width="1.5*" />
                            <!-- Total Bookings -->
                            <ColumnDefinition Width="1*" />
                            <!-- Total Revenue -->
                            <ColumnDefinition Width="1*" />

                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Habitación" Style="{StaticResource TableSubText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Categoría" Style="{StaticResource TableSubText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Total Reservas" Style="{StaticResource TableSubText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Ingresos Totales" Style="{StaticResource TableSubText}" FontWeight="SemiBold" />
                    </Grid>
                </Border>



                <!-- Cuerpo de la Tabla -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RoomStatsList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRowStyle}" Cursor="Hand" MouseDown="RoomRow_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource TableMainText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource TableMutedText}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="event" FontFamily="{StaticResource Material-Icons}" Foreground="{StaticResource Bg-Purple-Accent}" Margin="0,0,5,0" FontSize="14"/>
                                            <TextBlock Text="{Binding TotalBookings}" Style="{StaticResource TableMainText}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding TotalRevenue, StringFormat={}{0:N2}€}" FontWeight="Bold" Foreground="{StaticResource Bg-Success}" VerticalAlignment="Center" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>