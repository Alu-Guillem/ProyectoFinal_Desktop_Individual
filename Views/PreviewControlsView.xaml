<UserControl x:Class="Views.PreviewControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PereMaria.GestorHotel.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Components.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40" Background="Transparent">
            <TextBlock Text="Botones" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text-Primary}"
                       Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Botón Principal" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Botón Secundario" Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>

            <TextBlock Text="Dropdown / ComboBox" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Text-Primary}" Margin="0,20,0,10" />
            <ComboBox Style="{StaticResource DropdownStyle}" Width="200" Margin="0,0,0,10">
                <ComboBoxItem Content="Opción 1" />
                <ComboBoxItem Content="Opción 2" />
                <ComboBoxItem Content="Opción 3" />
            </ComboBox>

            <TextBlock Text="DatePicker" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text-Primary}"
                       Margin="0,20,0,10" />
            <DatePicker Style="{StaticResource DatePickerStyle}" Width="200" Margin="0,0,0,10" />

            <TextBlock Text="CheckBox" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text-Primary}"
                       Margin="0,20,0,10" />
            <CheckBox Content="Activo" Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,10" />

            <TextBlock Text="Tabla" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text-Primary}"
                       Margin="0,20,0,10" />
            <Border Style="{StaticResource TableBorderStyle}" Padding="20" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Header -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Estado" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Fecha" Style="{StaticResource TableHeaderText}" />
                    <!-- Row -->
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Juan Pérez" Style="{StaticResource TableText}" />
                        <TextBlock Text="VIP" Style="{StaticResource TableSubText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="Confirmado" Style="{StaticResource TableText}" />
                        <TextBlock Text="Pagado" Style="{StaticResource TableSubText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="17/01/2026" Style="{StaticResource TableText}" />
                        <TextBlock Text="Check-in" Style="{StaticResource TableSubText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Colores de la paleta" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Text-Primary}" Margin="0,30,0,10" />
            <UniformGrid Columns="4" Rows="0" Margin="0,0,0,20">
                <!-- Cada color con su nombre y StaticResource -->
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Cosmic-Dark}" CornerRadius="8" />
                    <TextBlock Text="Bg-Cosmic-Dark" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Cosmic-Dark}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Cosmic-Mid}" CornerRadius="8" />
                    <TextBlock Text="Bg-Cosmic-Mid" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Cosmic-Mid}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Cosmic-Light}" CornerRadius="8" />
                    <TextBlock Text="Bg-Cosmic-Light" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Cosmic-Light}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Purple-Accent}" CornerRadius="8" />
                    <TextBlock Text="Bg-Purple-Accent" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Purple-Accent}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Purple-Accent-Light}"
                            CornerRadius="8" />
                    <TextBlock Text="Bg-Purple-Accent-Light" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Purple-Accent-Light}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-White}" CornerRadius="8" />
                    <TextBlock Text="Bg-White" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-White}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Gray}" CornerRadius="8" />
                    <TextBlock Text="Bg-Gray" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Gray}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Dark}" CornerRadius="8" />
                    <TextBlock Text="Bg-Dark" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Dark}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Light}" CornerRadius="8" />
                    <TextBlock Text="Bg-Light" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Light}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Success}" CornerRadius="8" />
                    <TextBlock Text="Bg-Success" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Success}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Danger}" CornerRadius="8" />
                    <TextBlock Text="Bg-Danger" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Danger}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Warning}" CornerRadius="8" />
                    <TextBlock Text="Bg-Warning" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Warning}
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="10">
                    <Border Width="80" Height="80" Background="{StaticResource Bg-Info}" CornerRadius="8" />
                    <TextBlock Text="Bg-Info" Foreground="{StaticResource Text-Primary}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Text-Secondary}" FontSize="11" HorizontalAlignment="Center">
                        {StaticResource Bg-Info}
                    </TextBlock>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>