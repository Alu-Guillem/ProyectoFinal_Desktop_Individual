<Window x:Class="PereMaria.GestorHotel.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
        mc:Ignorable="d"
        Title="Login" Height="720" Width="1280">
    <Grid Background="{StaticResource CosmicBackground}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"></RowDefinition>
            <RowDefinition Height="1.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock FontSize="70" Foreground="{StaticResource Text-Primary}" Text="Hotel Pere Maria" HorizontalAlignment="Center"></TextBlock>
            <TextBlock FontSize="26" Foreground="{StaticResource Text-Secondary}" Text="Sistema De Administración" HorizontalAlignment="Center" Margin="0 15 0 0"></TextBlock>
        </StackPanel>
        <Border Grid.Row="1" Width="500" Height="300" Background="{StaticResource Bg-Cosmic-Mid}" CornerRadius="25" BorderThickness="1" BorderBrush="{StaticResource Bg-Purple-Accent}">
            <StackPanel>
                <Label Content="Correo Electrónico" Foreground="{StaticResource Text-Secondary}" FontSize="18"></Label>
                <TextBox Style="{StaticResource ModernTextBox}" Width="300"></TextBox>
            </StackPanel>
        </Border>

    </Grid>
</Window>
