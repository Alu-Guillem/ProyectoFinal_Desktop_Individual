<UserControl x:Class="PereMaria.GestorHotel.Views.RoomsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
    xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
    xmlns:components="clr-namespace:PereMaria.GestorHotel.Components"
    mc:Ignorable="d"
    d:DesignHeight="930" d:DesignWidth="1650"
    DataContext="{x:Static controllers:RoomsController.Instance}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>
        <Border  BorderBrush="{StaticResource Bg-Purple-Accent}" BorderThickness="2"  Grid.Row="1" Margin="20 0 20 0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"  Background="{StaticResource Bg-Cosmic-Dark}">
                <UniformGrid Margin="30" Columns="4">
                    <UniformGrid.Resources>
                        <Style TargetType="components:Habitaciones">
                            <Setter Property="Margin" Value="10"/>
                        </Style>
                    </UniformGrid.Resources>

                    <components:Habitaciones/>
                    <components:Habitaciones/>
                    <components:Habitaciones/>
                    <components:Habitaciones/>
                    <components:Habitaciones/>
                    <components:Habitaciones/>
                    <components:Habitaciones/>
                    <components:Habitaciones/>
                    <components:Habitaciones/>
                    <components:Habitaciones/>


                </UniformGrid>
            </ScrollViewer>
        </Border>
    </Grid>
    
    
</UserControl>