<UserControl x:Class="PereMaria.GestorHotel.Views.RoomsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
    xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
    xmlns:components="clr-namespace:PereMaria.GestorHotel.Components"
    mc:Ignorable="d"
    d:DesignHeight="930" d:DesignWidth="1650"
    DataContext="{x:Static controllers:RoomsController.Instance}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <UniformGrid Margin="60" Columns="3">
            <UniformGrid.Resources>
                <Style TargetType="components:Habitaciones">
                    <Setter Property="Margin" Value="15"/>
                </Style>
            </UniformGrid.Resources>

            <components:Habitaciones/>
            <components:Habitaciones/>
            <components:Habitaciones/>
            <components:Habitaciones/>
            <components:Habitaciones/>
            <components:Habitaciones/>
            <components:Habitaciones/>
            <components:Habitaciones/>
            <components:Habitaciones/>
            <components:Habitaciones/>


        </UniformGrid>
    </ScrollViewer>
    
</UserControl>