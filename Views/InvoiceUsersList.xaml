<UserControl x:Class="PereMaria.GestorHotel.Views.InvoiceUsersList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
             xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{x:Static controllers:InvoiceViewModel.Instance}"
             d:DataContext="{d:DesignInstance Type=controllers:InvoiceViewModel}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Historial de Facturación" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Bg-Light}"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Cliente: " Style="{StaticResource TableMutedText}" FontSize="16"/>
                <TextBlock Text="{Binding SelectedUser.FirstName}" Style="{StaticResource TableMutedText}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text=" " />
                <TextBlock Text="{Binding SelectedUser.LastName}" Style="{StaticResource TableMutedText}" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"  Style="{StaticResource TableContainerStyle}" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource TableHeaderStyle}">
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nº FACTURA" Style="{StaticResource TableMutedText}" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="FECHA RESERVA" Style="{StaticResource TableMutedText}" FontWeight="Bold" />
                        <TextBlock Grid.Column="2" Text="HABITACIÓN" Style="{StaticResource TableMutedText}" FontWeight="Bold" />
                        <TextBlock Grid.Column="3" Text="TIPO" Style="{StaticResource TableMutedText}" FontWeight="Bold" />
                        <TextBlock Grid.Column="4" Text="IMPORTE" Style="{StaticResource TableMutedText}" FontWeight="Bold" />
                    </Grid>
                </Border>
                

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding InvoicesList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Cursor="Hand" Style="{StaticResource TableRowStyle}" MouseLeftButtonDown="InvoiceRow_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding InvoiceNumber}" Style="{StaticResource TableMainText}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding BookingDate}" Style="{StaticResource TableMutedText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding RoomName}" Style="{StaticResource TableMainText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding RoomType}" Style="{StaticResource TableMutedText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding TotalPrice, StringFormat={}{0:N2}€}" FontWeight="Bold" Foreground="{StaticResource Bg-Success}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
