<UserControl x:Class="PereMaria.GestorHotel.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
             xmlns:components="clr-namespace:PereMaria.GestorHotel.Components"
             xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             DataContext="{x:Static controllers:EmployeesViewModel.Instance}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Components.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <TextBlock Text="Personal de Galactic Heaven" 
                           FontSize="40" FontWeight="Bold" 
                           Foreground="{StaticResource Text-Primary}" 
                           Margin="0,0,0,30"/>
                
                <Button Content="Nuevo Empleado" 
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding OpenEmployeeFormCommand}"
                        CommandParameter="{x:Null}" 
                        HorizontalAlignment="Right"/>

                <ItemsControl ItemsSource="{Binding Employees}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" Rows="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="420" Margin="15" 
                                    Background="{StaticResource Bg-Cosmic-Dark}" 
                                    CornerRadius="20">
                                
                                <Grid Margin="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> 
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <components:AvatarInitial Grid.Row="0" 
                                                             Initial="{Binding FirstName[0]}" 
                                                             Size="110" 
                                                             HorizontalAlignment="Center" 
                                                             Margin="0,10"/>

                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding FirstName}" FontSize="26" FontWeight="Bold" 
                                                   Foreground="{StaticResource Text-Primary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Role}" FontSize="16" 
                                                   Foreground="{StaticResource Text-Secondary}" HorizontalAlignment="Center"/>
                                        <Border Height="1" Width="280" 
                                                Background="{StaticResource Bg-Purple-Accent}" 
                                                Opacity="0.6" Margin="0,15"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                                            <TextBlock Foreground="{StaticResource  Bg-Purple-Accent}"
                                                       FontFamily="{StaticResource Material-Icons}"
                                                       FontSize="20"
                                                       Text="mail"
                                                       VerticalAlignment="Center"
                                                       Margin="0 0 5 0"
                                                       >
                                            </TextBlock>
                                            <TextBlock Text="{Binding Email}" Foreground="{StaticResource Text-Secondary}" FontSize="14"  VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Row="3" Content="Activo" 
                                            Style="{StaticResource PrimaryButtonStyle}" 
                                            Background="{StaticResource Bg-Success}" 
                                            Width="110" Height="36" 
                                            HorizontalAlignment="Center"/>
                                    
                                    <Button Grid.Row="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        Cursor="Hand"
                                        Grid.RowSpan="4"
                                        Command="{Binding DataContext.OpenEmployeeFormCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>