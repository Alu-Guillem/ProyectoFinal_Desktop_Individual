<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Table Backgrounds and Borders -->
    <SolidColorBrush x:Key="Table-Bg"
                     Color="{DynamicResource Color-Cosmic-Dark}" />
    <SolidColorBrush x:Key="Table-Border"
                     Color="#2d2055" />
    <SolidColorBrush x:Key="Table-Header-Bg"
                     Color="#251b47" />
    <SolidColorBrush x:Key="Table-Header-Border"
                     Color="#2d2055" />
    <SolidColorBrush x:Key="Table-Row-Bg"
                     Color="Transparent" />
    <SolidColorBrush x:Key="Table-Row-Hover"
                     Color="#33FFFFFF" /> <!-- Blanco muy transparente -->

    <!-- Table Text Styles -->
    <Style x:Key="TableMainText"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{DynamicResource Text-Primary}" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="FontSize"
                Value="13" />
    </Style>
    <Style x:Key="TableSubText"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="#8b8ba7" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="FontSize"
                Value="13" />
    </Style>
    <Style x:Key="TableMutedText"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="#b8b8d1" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="FontSize"
                Value="13" />
    </Style>

    <!-- Table Row Style with Hover -->
    <Style x:Key="TableRowStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource Table-Row-Bg}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Table-Border}" />
        <Setter Property="BorderThickness"
                Value="0,0,0,1" />
        <Setter Property="Padding"
                Value="20,15" />
        <Setter Property="Cursor"
                Value="Hand">
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource Table-Row-Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Table Header Style -->
    <Style x:Key="TableHeaderStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource Table-Header-Bg}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Table-Header-Border}" />
        <Setter Property="BorderThickness"
                Value="0,0,0,1" />
        <Setter Property="Padding"
                Value="20,15" />
        <Setter Property="CornerRadius"
                Value="12 12 0 0" />
    </Style>

    <!-- Table Container Style -->
    <Style x:Key="TableContainerStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource Table-Bg}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Table-Border}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="12" />
        <Setter Property="Margin"
                Value="0 15" />
    </Style>
</ResourceDictionary>