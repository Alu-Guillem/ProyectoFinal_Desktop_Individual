<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Botón principal -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Bg-Purple-Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Text-Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#6A4C93" BlurRadius="8" ShadowDepth="0" Opacity="0.15" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Bg-Purple-Accent-Light}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#6A4C93" BlurRadius="16" ShadowDepth="0" Opacity="0.25" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón secundario -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Nav-Active}"/>
        <Setter Property="Foreground" Value="{StaticResource Text-Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#3D2D6D" BlurRadius="8" ShadowDepth="0" Opacity="0.12" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Nav-Hover}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#3D2D6D" BlurRadius="16" ShadowDepth="0" Opacity="0.22" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ToggleButton para ComboBox -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0">
            <Grid>
                <Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="White" Width="12" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- ComboBox / Dropdown funcional y moderno, basado en el template original -->
    <Style x:Key="DropdownStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Bg-Cosmic-Mid}"/>
        <Setter Property="Foreground" Value="{StaticResource Text-Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bg-Purple-Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Fondo visual principal (Bd) -->
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" />

                        <!-- Botón desplegable (Ocupa todo el espacio para facilitar el click) -->
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Margin="0"
                                      Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Grid>
                                            <Path Data="M 0 0 L 8 0 L 4 5 Z"
                                                  Fill="White"
                                                  Width="12" Height="8"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,15,0"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Contenido Seleccionado (No bloquea clicks) -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="15,0,40,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>

                        <!-- Popup de opciones -->
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                <Border Background="{StaticResource Bg-Cosmic-Light}" BorderBrush="{StaticResource Bg-Purple-Accent}" BorderThickness="1" CornerRadius="8" Padding="4">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover Global -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#6A4C93DD"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8A6CB3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                        <!-- Focus (Teclado o click) -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#6A4C93" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Cuando está desplegado -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#6A4C93" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo limpio para el TextBox interno del DatePicker (quita el borde default) -->
    <Style x:Key="DatePickerTextBoxStyle" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Grid Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="{TemplateBinding Padding}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    <!-- TextBox funcional y moderno, basado en el template original -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Bg-Purple-Accent}"/> 
        <Setter Property="Foreground" Value="{StaticResource Text-Primary}"/> 
        <Setter Property="BorderBrush" Value="{StaticResource Bg-Purple-Accent}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource Bg-Purple-Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" 
                            SnapsToDevicePixels="True">
                        
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="false"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="#A27BFF"/>
                            <Setter Property="Background" Value="#2D1B4A"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="#A27BFF"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
                            
                            
    
    <!-- DatePicker funcional y moderno, click en todo el elemento -->
    <Style x:Key="DatePickerStyle" TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource Bg-Purple-Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Text-Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bg-Purple-Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Height="40">
                            <Grid>
                                <!-- Botón que ocupa todo el espacio (detrás del texto) -->
                                <Button x:Name="PART_Button"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="0"
                                        Focusable="False"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <!-- Icono alineado a la derecha -->
                                                <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path Data="M 4 8 L 12 8 M 4 12 L 12 12 M 2 4 L 14 4 L 14 14 L 2 14 Z" Stroke="White" StrokeThickness="2"/>
                                </Button>

                                <!-- Caja de texto (No clickable, para que el click pase al botón) -->
                                <DatePickerTextBox x:Name="PART_TextBox"
                                    Style="{StaticResource DatePickerTextBoxStyle}"
                                    Background="Transparent"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="14"
                                    VerticalContentAlignment="Center"
                                    BorderThickness="0"
                                    Margin="15,0,40,0"
                                    IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource Bg-Cosmic-Light}" BorderBrush="{StaticResource Bg-Purple-Accent}" BorderThickness="1" CornerRadius="8" Padding="4">
                                <Calendar x:Name="PART_Calendar" Background="{StaticResource Bg-Cosmic-Light}" Foreground="{StaticResource Text-Primary}"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#6A4C93DD"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8A6CB3"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#6A4C93" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox -->
    <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text-Primary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="Background" Value="{StaticResource Bg-Purple-Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Bg-Purple-Accent}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="✔" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <TextBlock Text="{TemplateBinding Content}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabla base -->
    <Style x:Key="TableBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg-Cosmic-Mid}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource Nav-Hover}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Texto principal de tabla -->
    <Style x:Key="TableText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text-Primary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Texto secundario de tabla -->
    <Style x:Key="TableSubText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text-Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Header de tabla -->
    <Style x:Key="TableHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text-Secondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
